<events>
    <!--
        Feature introductions: in-place banner, What's New index, settings deep
        link, and the "New" badge on the owning settings group.

        This test needs an install that predates the announced feature (an older
        clientVersion and no explicit hover trigger), which run_test.sh does not
        set up, so it runs with a prepared HOME instead of the developer's
        settings. See Testing/README.md, "A prepared HOME for upgrade-state
        tests", for the four files that HOME needs and the exact command. Two
        traps that cost a debugging session each:

        - The card database's set must be enabled AND known in cardDatabase.ini.
          Otherwise startup opens the modal "all sets enabled" welcome (or the
          "new sets found" question) before the first event and playback never
          starts: the run times out with no failing event, which looks like a
          harness hang.
        - Widget paths include Qt's unnamed-sibling indices, and the settings
          dialog opened via the What's New deep link numbers them differently
          from the one opened from the menu. The badge paths below come from the
          dump taken at this point in this order (dumpTree, then read the
          "Possible match:" hint if one of them ever misses).

        Order matters: the banner and the badge both require the entry to still be
        Pending, so the "Use classic" / "Undo" steps run after the settings visits.
        The screenshots are the deliverable.
    -->
    <event widget="MainWindow" command="resize" arguments="1280x800" />
    <event widget="MainWindow" command="process_events" arguments="3000" />

    <!-- Start a local game: the banner belongs above the board, not in a dialog -->
    <event widget="MainWindow/menubar" command="activate" arguments="cockatriceMenu" />
    <event widget="MainWindow/menubar/cockatriceMenu" command="activate" arguments="Start &amp;local game..." />
    <event widget="MainWindow/localGameDialog/generalGroupBox/numberPlayersEdit" command="set_int" arguments="2" />
    <event widget="MainWindow/localGameDialog" command="key" arguments="16777220" />
    <event widget="MainWindow" command="process_events" arguments="3000" />
    <event widget="MainWindow/tabSupervisor/stackedWidget/TabGame/mainWidget/gamePlayAreaWidget/featureIntroBanner/featureIntroBannerTitle" command="expectProperty" arguments="text,Hover zoom and a tabbed card panel" />
    <event widget="MainWindow/tabSupervisor/stackedWidget/TabGame/mainWidget/gamePlayAreaWidget/featureIntroBanner" command="screenshot" arguments="$COCKATRICE_SCREENSHOT_DIR/feature-intro-banner.png" />

    <!-- Help > What's New: the browsable index; opening it decides nothing -->
    <event widget="MainWindow/menubar" command="activate" arguments="helpMenu" />
    <event widget="MainWindow/menubar/helpMenu" command="activate" arguments="actionWhatsNew" />
    <event widget="MainWindow" command="pause" arguments="500" />
    <event widget="MainWindow/whatsNewDialog" command="expectProperty" arguments="visible,true" />
    <event widget="MainWindow/whatsNewDialog" command="screenshot" arguments="$COCKATRICE_SCREENSHOT_DIR/feature-intro-whats-new.png" />

    <!-- Settings... deep-links into the hover-panel settings group -->
    <event widget="MainWindow" command="pause" arguments="200" />
    <event widget="MainWindow/whatsNewDialog/whatsNewScroll/qt_scrollarea_viewport/1QWidget0/whatsNewEntry/whatsNewEntrySettings" command="activate" arguments="" />
    <event widget="MainWindow" command="pause" arguments="700" />
    <event widget="MainWindow/settingsDialog/settingsView/settingsSearchEdit" command="expectProperty" arguments="text,Hover panel settings" />
    <event widget="MainWindow/settingsDialog/settingsView" command="screenshot" arguments="$COCKATRICE_SCREENSHOT_DIR/feature-intro-settings-link.png" />
    <event widget="MainWindow/settingsDialog/settingsView" command="dumpTree" arguments="$COCKATRICE_SCREENSHOT_DIR/settings-tree.txt" />
    <event widget="MainWindow/settingsDialog/settingsOkButton" command="activate" arguments="" />
    <event widget="MainWindow" command="pause" arguments="300" />
    <event widget="MainWindow/whatsNewDialog" command="key" arguments="16777216" />
    <event widget="MainWindow" command="pause" arguments="300" />

    <!-- The badge on the owning settings group, still Pending -->
    <event widget="MainWindow/menubar" command="activate" arguments="cockatriceMenu" />
    <event widget="MainWindow/menubar/cockatriceMenu" command="activate" arguments="actionSettings" />
    <event widget="MainWindow" command="pause" arguments="500" />
    <event widget="MainWindow/settingsDialog/settingsView/navTree" command="selectItem" arguments="User Interface" />
    <event widget="MainWindow" command="pause" arguments="500" />
    <event widget="MainWindow/settingsDialog/settingsView/pagesContainer/pagesWidget" command="expectProperty" arguments="currentIndex,2" />
    <event widget="MainWindow/settingsDialog/settingsView" command="screenshot" arguments="$COCKATRICE_SCREENSHOT_DIR/feature-intro-settings-page.png" />
    <!-- The badge lives on the hover group box, below the page's first screen: grab
         the group itself instead of a viewport that would not show it. -->
    <event widget="MainWindow/settingsDialog/settingsView/pagesContainer/pagesWidget/1QScrollArea0/qt_scrollarea_viewport/1UserInterfaceSettingsPage0/1QGroupBox3/featureIntroBadge" command="expectProperty" arguments="visible,true" />
    <event widget="MainWindow/settingsDialog/settingsView/pagesContainer/pagesWidget/1QScrollArea0/qt_scrollarea_viewport/1UserInterfaceSettingsPage0/1QGroupBox3/featureIntroBadge" command="expectProperty" arguments="text,New" />
    <event widget="MainWindow/settingsDialog/settingsView/pagesContainer/pagesWidget/1QScrollArea0/qt_scrollarea_viewport/1UserInterfaceSettingsPage0/1QGroupBox3" command="screenshot" arguments="$COCKATRICE_SCREENSHOT_DIR/feature-intro-badge.png" />
    <event widget="MainWindow/settingsDialog/settingsView/settingsSearchEdit" command="typeText" arguments="Hover panel settings" />
    <event widget="MainWindow" command="pause" arguments="500" />
    <event widget="MainWindow/settingsDialog/settingsView" command="dumpTree" arguments="$COCKATRICE_SCREENSHOT_DIR/settings-search-tree.txt" />
    <event widget="MainWindow/settingsDialog/settingsOkButton" command="activate" arguments="" />
    <event widget="MainWindow" command="pause" arguments="300" />

    <!-- Use classic: the banner becomes the undo row -->
    <event widget="MainWindow/tabSupervisor/stackedWidget/TabGame/mainWidget/gamePlayAreaWidget/featureIntroBanner/featureIntroBannerDecline" command="activate" arguments="" />
    <event widget="MainWindow" command="pause" arguments="300" />
    <event widget="MainWindow/tabSupervisor/stackedWidget/TabGame/mainWidget/gamePlayAreaWidget/featureIntroBanner/featureIntroBannerOutcome" command="expectProperty" arguments="text,Hover zoom and the card panel are off." />
    <event widget="MainWindow/tabSupervisor/stackedWidget/TabGame/mainWidget/gamePlayAreaWidget/featureIntroBanner" command="screenshot" arguments="$COCKATRICE_SCREENSHOT_DIR/feature-intro-banner-undo.png" />

    <!-- Undo restores the new behavior and closes the banner -->
    <event widget="MainWindow/tabSupervisor/stackedWidget/TabGame/mainWidget/gamePlayAreaWidget/featureIntroBanner/featureIntroBannerUndo" command="activate" arguments="" />
    <event widget="MainWindow" command="pause" arguments="300" />
</events>
