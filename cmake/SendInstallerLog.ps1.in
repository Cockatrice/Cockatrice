# Sends the NSIS installer log to Sentry as an envelope carrying one error
# event plus the log as an attachment.
#
# Generated at configure time from this template by CMake configure_file: the
# CPACK_SENTRY_* placeholders are baked in then, so the real values only ever
# exist in the build directory and the packaged installer, never in the repo.
# Runs on stock Windows PowerShell 5.1 with no extra modules.
param(
    [Parameter(Mandatory = $true)][string]$LogPath,
    [Parameter(Mandatory = $true)][string]$Reason
)

$ErrorActionPreference = 'Stop'

$EnvelopeUrl = '@CPACK_SENTRY_ENVELOPE_URL@'
$SentryKey = '@CPACK_SENTRY_KEY@'
$Release = '@CPACK_SENTRY_RELEASE@'
$Dsn = '@CPACK_SENTRY_DSN_FULL@'

try {
    # The envelope endpoint is TLS-only; stock powershell.exe on older systems
    # still negotiates TLS 1.0 otherwise, so opt into 1.2 explicitly.
    try {
        [Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12
    } catch {
    }

    # --- Log payload, tail-capped at 128 KiB ---------------------------------
    $MaxLogBytes = 128 * 1024
    $TruncNotice = '[log truncated to last 128 KB]'
    if (Test-Path -LiteralPath $LogPath) {
        $raw = [System.IO.File]::ReadAllBytes($LogPath)
    } else {
        $raw = [System.Text.Encoding]::UTF8.GetBytes('(installer log not found: ' + $LogPath + ')')
    }
    if ($raw.Length -gt $MaxLogBytes) {
        $tail = New-Object byte[] $MaxLogBytes
        [System.Buffer]::BlockCopy($raw, $raw.Length - $MaxLogBytes, $tail, 0, $MaxLogBytes)
        $prefix = [System.Text.Encoding]::UTF8.GetBytes($TruncNotice + "`r`n")
        $logBytes = New-Object byte[] ($prefix.Length + $tail.Length)
        [System.Buffer]::BlockCopy($prefix, 0, $logBytes, 0, $prefix.Length)
        [System.Buffer]::BlockCopy($tail, 0, $logBytes, $prefix.Length, $tail.Length)
    } else {
        $logBytes = $raw
    }

    # --- Event ---------------------------------------------------------------
    $eventId = [guid]::NewGuid().ToString('N')
    $now = (Get-Date).ToUniversalTime().ToString('yyyy-MM-ddTHH:mm:ssZ')
    $firstLine = ($Reason -split "`r?`n")[0]
    $event = [ordered]@{
        event_id = $eventId
        timestamp = $now
        platform = 'other'
        level = 'error'
        logger = 'cockatrice-installer'
        release = $Release
        environment = 'installer'
        sdk = @{ name = 'cockatrice.installer'; version = $Release }
        message = @{ formatted = 'Installer aborted: ' + $firstLine }
        extra = @{
            reason = $Reason
            os = [System.Environment]::OSVersion.VersionString
        }
    }
    $eventJson = $event | ConvertTo-Json -Compress -Depth 6
    $eventBytes = [System.Text.Encoding]::UTF8.GetBytes($eventJson)

    # --- Envelope, assembled as bytes (the log is opaque binary) -------------
    $sentAt = (Get-Date).ToUniversalTime().ToString('yyyy-MM-ddTHH:mm:ssZ')
    $headerLine = '{"event_id":"' + $eventId + '","sent_at":"' + $sentAt + '","dsn":"' + $Dsn + '"}'
    $eventHeader = '{"type":"event","length":' + $eventBytes.Length + '}'
    $attachHeader = '{"type":"attachment","filename":"Cockatrice-installer.log","content_type":"text/plain","length":' + $logBytes.Length + '}'
    $enc = [System.Text.Encoding]::UTF8
    $lf = [byte[]]@(10)
    $body = New-Object System.IO.MemoryStream
    foreach ($chunk in @($enc.GetBytes($headerLine), $lf, $enc.GetBytes($eventHeader), $lf, $eventBytes, $lf, $enc.GetBytes($attachHeader), $lf, $logBytes)) {
        $body.Write($chunk, 0, $chunk.Length)
    }
    $bodyBytes = $body.ToArray()
    $body.Close()

    # --- Send ----------------------------------------------------------------
    # The key travels in the auth header only; stdout below never contains it.
    $auth = 'Sentry sentry_version=7, sentry_client=cockatrice.installer/' + $Release + ', sentry_key=' + $SentryKey
    Invoke-RestMethod -Uri $EnvelopeUrl -Method Post -ContentType 'application/x-sentry-envelope' -Headers @{ 'X-Sentry-Auth' = $auth } -Body $bodyBytes | Out-Null
    Write-Output ('SENT ' + $eventId)
    exit 0
} catch {
    # Scrub the key/DSN out of the failure text in case a transport error echoes them.
    $msg = $_.Exception.Message
    if ($msg -and $SentryKey) {
        $msg = $msg.Replace($SentryKey, '<redacted>')
    }
    if ($msg -and $Dsn) {
        $msg = $msg.Replace($Dsn, '<redacted>')
    }
    Write-Output ('FAILED: ' + $msg)
    exit 1
}
